{
  "name": "osint-ig",
  "private": true,
  "version": "0.5.0",
  "description": "Analiza profilu Instagram i mapa powiązań: aplikacja web (Vite + React) i desktop (Tauri). Backend Node bez zależności runtime.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node api/server.js",
    "serve": "npm run build && npm start",
    "test": "node api/test.js && node --test api/extension-bridge.check.cjs api/session.check.cjs api/profile.check.cjs api/followers.check.cjs && vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "build:names": "node api/build-names.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:icons": "node scripts/make-icon.mjs && tauri icon src-tauri/app-icon.png",
    "tauri": "tauri",
    "desktop:dev": "npm run build:sidecar && tauri dev",
    "desktop:build": "npm run build:sidecar && tauri build",
    "build:exe": "node scripts/build-exe.mjs",
    "launch": "node scripts/launch.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@stdlib/datasets-female-first-names-en": "^0.2.3",
    "@stdlib/datasets-male-first-names-en": "^0.2.3",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "esbuild": "^0.28.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "gender-detection": "^0.1.0",
    "globals": "^17",
    "human-names": "^1.0.13",
    "imieniny": "^1.0.1",
    "playwright-core": "^1.56.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
